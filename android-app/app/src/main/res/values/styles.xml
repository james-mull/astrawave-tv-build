<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AstraWaveButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/astrawave_button_background</item>
        <item name="android:textColor">#F9FAFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Theme.AstraWave" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">#8D7CFF</item>
        <item name="android:navigationBarColor">#05070B</item>
        <item name="android:statusBarColor">#05070B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:buttonStyle">@style/AstraWaveButton</item>
        <item name="android:windowBackground">#05070B</item>
    </style>
</resources>
