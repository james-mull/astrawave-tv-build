rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    function hasUpdatedAt() { return request.resource.data.updatedAt is timestamp; }

    function validProfile() {
      return onlyKeys(['displayName','avatarUrl','kidsMode','createdAt','updatedAt']) &&
        (!('displayName' in request.resource.data) || request.resource.data.displayName is string) &&
        (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl is string) &&
        (!('kidsMode' in request.resource.data) || request.resource.data.kidsMode is bool);
    }
    function validWatchlist(docId) { return request.resource.data.mediaId == docId && request.resource.data.kind is string && request.resource.data.title is string && hasUpdatedAt(); }
    function validProgress(docId) { return request.resource.data.mediaId == docId && request.resource.data.kind is string && request.resource.data.title is string && request.resource.data.positionMs is number && request.resource.data.durationMs is number && request.resource.data.positionMs >= 0 && request.resource.data.durationMs >= 0 && hasUpdatedAt(); }
    function validFavoriteTeam(docId) { return request.resource.data.teamId == docId && request.resource.data.name is string && hasUpdatedAt(); }
    function validSettings() { return request.resource.data is map && hasUpdatedAt(); }
    function validSource() { return request.resource.data.name is string && request.resource.data.type is string && request.resource.data.enabled is bool && (!('priority' in request.resource.data) || request.resource.data.priority is number) && (!('config' in request.resource.data) || request.resource.data.config is map) && hasUpdatedAt(); }
    function validChannelCustomization() {
      return request.resource.data.profileId is string &&
        request.resource.data.channelId is string &&
        request.resource.data.channelId.size() > 0 &&
        request.resource.data.hidden is bool &&
        (!('customName' in request.resource.data) || request.resource.data.customName == null || request.resource.data.customName is string) &&
        (!('customNumber' in request.resource.data) || request.resource.data.customNumber == null || request.resource.data.customNumber is number) &&
        (!('customGroup' in request.resource.data) || request.resource.data.customGroup == null || request.resource.data.customGroup is string) &&
        (!('sortOrder' in request.resource.data) || request.resource.data.sortOrder is number) &&
        (!('epgIdOverride' in request.resource.data) || request.resource.data.epgIdOverride == null || request.resource.data.epgIdOverride is string) &&
        (!('logoUrlOverride' in request.resource.data) || request.resource.data.logoUrlOverride == null || request.resource.data.logoUrlOverride is string) &&
        hasUpdatedAt();
    }
    function validDevice() { return request.resource.data.name is string && request.resource.data.type is string && request.resource.data.online is bool && request.resource.data.lastSeenAt is timestamp; }
    function validCommand() { return request.resource.data.deviceId is string && request.resource.data.command is string && request.resource.data.status is string && request.resource.data.createdAt is timestamp; }
    function validRecording() { return request.resource.data.title is string && request.resource.data.channelId is string && request.resource.data.sourceId is string && request.resource.data.startEpochMs is number && request.resource.data.endEpochMs is number && request.resource.data.state is string && hasUpdatedAt(); }
    function validDownload() { return request.resource.data.mediaId is string && request.resource.data.kind is string && request.resource.data.title is string && request.resource.data.state is string && request.resource.data.progressPercent is number && request.resource.data.progressPercent >= 0 && request.resource.data.progressPercent <= 100 && hasUpdatedAt(); }
    function validHousehold() { return request.resource.data.name is string && request.resource.data.profileIds is list && request.resource.data.candidates is list && request.resource.data.votes is list && request.resource.data.status is string && hasUpdatedAt(); }
    function validSportsReminder() { return request.resource.data.eventId is string && request.resource.data.title is string && request.resource.data.startTime is string && request.resource.data.enabled is bool && hasUpdatedAt(); }
    function validPlaybackDiagnostic() {
      return onlyKeys(['title','mediaType','provider','quality','latencyMs','providerCount','backupCount','personalMedia','debridOptimized','resolvedAtEpochMs','updatedAt']) &&
        request.resource.data.title is string &&
        request.resource.data.mediaType is string &&
        request.resource.data.provider is string &&
        (!('quality' in request.resource.data) || request.resource.data.quality == null || request.resource.data.quality is string) &&
        (!('latencyMs' in request.resource.data) || request.resource.data.latencyMs == null || request.resource.data.latencyMs is number) &&
        request.resource.data.providerCount is number && request.resource.data.providerCount >= 0 &&
        request.resource.data.backupCount is number && request.resource.data.backupCount >= 0 &&
        request.resource.data.personalMedia is bool &&
        request.resource.data.debridOptimized is bool &&
        request.resource.data.resolvedAtEpochMs is number &&
        hasUpdatedAt();
    }

    match /profiles/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && validProfile();
      allow delete: if false;
    }

    match /users/{uid} {
      allow read, create, update: if owns(uid) && validProfile();
      allow delete: if false;

      match /watchlist/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validWatchlist(docId); allow delete: if owns(uid); }
      match /progress/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validProgress(docId); allow delete: if owns(uid); }
      match /favoriteTeams/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validFavoriteTeam(docId); allow delete: if owns(uid); }
      match /settings/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validSettings(); allow delete: if owns(uid); }
      match /sources/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validSource(); allow delete: if owns(uid); }
      match /channelCustomizations/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validChannelCustomization(); allow delete: if owns(uid); }
      match /devices/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validDevice(); allow delete: if owns(uid); }
      match /commands/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validCommand(); allow delete: if owns(uid); }
      match /recordings/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validRecording(); allow delete: if owns(uid); }
      match /downloads/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validDownload(); allow delete: if owns(uid); }
      match /household/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validHousehold(); allow delete: if owns(uid); }
      match /sportsReminders/{docId} { allow read: if owns(uid); allow create, update: if owns(uid) && validSportsReminder(); allow delete: if owns(uid); }

      match /profiles/{profileId} {
        allow read: if owns(uid);
        match /playbackDiagnostics/{docId} {
          allow read: if owns(uid);
          allow create, update: if owns(uid) && validPlaybackDiagnostic();
          allow delete: if owns(uid);
        }
      }
    }

    match /entitlements/{uid} { allow read: if owns(uid); allow write: if false; }
    match /public/{document=**} { allow read: if true; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
