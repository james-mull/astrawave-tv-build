rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /profiles/{uid} {
      allow read, create, update: if owns(uid);
      allow delete: if false;
    }

    match /users/{uid}/{subcollection}/{docId} {
      allow read, write: if owns(uid) && subcollection in ['watchlist', 'progress', 'favoriteTeams', 'settings', 'sources'];
    }

    match /entitlements/{uid} {
      allow read: if owns(uid);
      allow write: if false;
    }

    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
