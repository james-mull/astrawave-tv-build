# Firebase Web App public configuration
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDCVU-Xte6aog6xPkDdqcNny1reQjn7lrY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=astrawave.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=astrawave
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=astrawave.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1053104069475
NEXT_PUBLIC_FIREBASE_APP_ID=1:1053104069475:web:122e095549dafb87f81156

# Server-only catalog/feed configuration
TMDB_BEARER_TOKEN=

# Optional Podcast Index integration. Keep both values server-side only.
# AstraWave merges Podcast Index with Apple Podcasts directory fallback.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# Optional Trakt discovery + account sync.
# CLIENT_ID enables public discovery rails. CLIENT_SECRET is required only for user/device OAuth.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# Long random server-only value used to AES-GCM encrypt persisted integration tokens.
ASTRAWAVE_INTEGRATION_TOKEN_KEY=
# Optional dedicated Firebase service account for server-side private integration storage.
# If omitted, AstraWave can reuse GOOGLE_PLAY_SERVICE_ACCOUNT_JSON when that account has Firestore access.
ASTRAWAVE_FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional live TV overrides. If empty, AstraWave uses reviewed/public free playlist fallbacks.
ASTRAWAVE_LIVE_M3U_URL=
ASTRAWAVE_LIVE_M3U_URLS=
THESPORTSDB_API_KEY=123
